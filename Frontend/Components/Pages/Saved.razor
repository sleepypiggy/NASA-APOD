@page "/saved"

@inject IHttpClientFactory HttpClientFactory;

<div id="saved-apods">
    <table class="apod-table"> 
        <thead>
            <tr>
                <th> Id </th>
                <th> Title </th>
                <th> Date </th>
                <th> Explanation </th>
                <th> Media Type </th>
                <th> Service Version </th>
                <th> Image </th>
                <th> HD-Image </th>
                <th> Command </th>
            </tr>
        </thead>
        <tbody>
            @foreach(Apod apod in SavedApods)
            {
                <tr>
                    <td> @apod.Id </td>
                    <td> @apod.Title </td>
                    <td> @apod.Date </td>
                    <td>
                        <button popovertarget="view-explanation-@apod.Id"> Explanation </button>
                        <div id="view-explanation-@apod.Id" popover class="popover-box"> 
                            <p> @apod.Explanation </p>
                        </div>
                    </td>
                    <td> @apod.MediaType </td>
                    <td> @apod.ServiceVersion </td>
                    <td>
                        <button popovertarget="view-image-@apod.Id"> Image </button>
                        <div id="view-image-@apod.Id" popover class="popover-box">
                            <img src="@apod.Url" class="view-saved-image"/>
                        </div>
                    </td>
                    <td>
                        <button popovertarget="view-hd-image-@apod.Id"> HD Image </button>
                        <div id="view-hd-image-@apod.Id" popover class="popover-box">
                            <img src="@apod.Hdurl" class="view-saved-image"/>
                        </div>
                    </td>
                    <td> 
                        <button @onclick="() => DeleteApod(apod)"> X </button>
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>

@code {
    List<Apod> SavedApods = new List<Apod>();
    protected override async Task OnInitializedAsync()
    {
        var httpClient = HttpClientFactory.CreateClient("Api");
        SavedApods = await httpClient.GetFromJsonAsync<List<Apod>>("/apod/") ?? [];
    }

    private async void DeleteApod(Apod apod)
    {
        SavedApods.Remove(apod);
        var httpClient = HttpClientFactory.CreateClient("Api");
        await httpClient.DeleteAsync($"/apod/saved/id/{apod.Id}");
    }
}
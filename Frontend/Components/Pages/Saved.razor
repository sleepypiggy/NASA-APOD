@page "/saved"

@using HtmlAgilityPack;
@using System.Web;
@inject IHttpClientFactory HttpClientFactory;

<div id="saved-apods">
    <div id="saved-apods-grid">

        @foreach(Apod apod in SavedApods)
        {
            <div>
                @* might make image click go to popover? *@
                <a href="@apod.Hdurl" target="none" id="img-url">
                    <img src="@apod.Hdurl" class="saved-image"/>
                </a>
                <div id="saved-apod-info">
                    <p class="grid-item"> ID: @apod.Id </p>
                    <p class="grid-item"> Title: @apod.Title </p>
                    <p class="grid-item"> Date: @apod.Date </p>
                    <p class="grid-item"> Media Type: @apod.MediaType </p>
                    <div id="button-container">
                        <button popovertarget="view-explanation-@apod.Id" id="explanation-button"> Explanation </button>
                        <div id="view-explanation-@apod.Id" popover class="popover-box"> 
                            <p> @getExplanation(apod) </p>
                        </div>
                        <button @onclick="() => DeleteApod(apod)" id="delete-button"> Delete </button>
                    </div>
                </div>
            </div>
        }

    </div>
</div>

@code {
    List<Apod> SavedApods = new List<Apod>();
    protected override async Task OnInitializedAsync()
    {
        var httpClient = HttpClientFactory.CreateClient("Api");
        SavedApods = await httpClient.GetFromJsonAsync<List<Apod>>("/apod/") ?? [];
    }

     // turn explanation with html markup into raw text (without the html elements)
    private string getExplanation(Apod apod)
    {
        string htmlMarkup = apod.Explanation;
        var htmlDoc = new HtmlDocument();
        htmlDoc.LoadHtml(htmlMarkup);
        string rawText = htmlDoc.DocumentNode.InnerText;
        string plainText = HttpUtility.HtmlDecode(rawText);
        return plainText;
    }

    private async Task DeleteApod(Apod apod)
    {
        SavedApods.Remove(apod);
        var httpClient = HttpClientFactory.CreateClient("Api");
        await httpClient.DeleteAsync($"/apod/saved/id/{apod.Id}");
    }
}
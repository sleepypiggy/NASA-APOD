@page "/"

@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.Web
@using HtmlAgilityPack
@inject IHttpClientFactory HttpClientFactory

@if (apod is null) {
    <p> Loading... </p>
} 
else 
{
    <div class="apod-container">
        <div class="picture-title-container">
            @* <button popovertarget="hd-image-@apod.Id" id="popover-button">
                <img src="@apod.Url" alt="Astronomy picture for @apod.Date" id="pod"/>
            </button>
            <img popover src="@apod.Hdurl" id="hd-image-@apod.Id" /> *@
            <img src="@apod.Hdurl" alt="Astronomy picture for @apod.Date" id="pod"/>
            <h2 id="title"> @apod.Title </h2>
        </div>
        <div class="control-container"> 
            <p> Media Type: @apod.MediaType </p>
            @* <p> Version: @apod.ServiceVersion </p> *@
            <NavLink href="@apod.Hdurl" id="hd-image-link" target="_blank"> HD Image </NavLink> <br />
            <input type="Date" min ="1995-06-16" @bind="SelectedDate" id="date-selector"/> <br />
            <button @onclick="GetApod" id="find-apod-button" class="button"> Find </button>
            <button @onclick="SaveApod" id="save-apod-button" class="button"> Save </button>
        </div>
        <div class="explanation-container"> 
            <p> @getExplanation(apod) </p>
        </div>
    </div>
}




@code {
    private DateOnly SelectedDate{ get; set; } = DateOnly.FromDateTime(DateTime.Today);
    private Apod? apod;

    protected override async Task OnInitializedAsync()
    {
        await GetApod();
    }

    // turn explanation with html markup into raw text (without the html elements)
    private string getExplanation(Apod apod)
    {
        string htmlMarkup = apod.Explanation;
        var htmlDoc = new HtmlDocument();
        htmlDoc.LoadHtml(htmlMarkup);
        string rawText = htmlDoc.DocumentNode.InnerText;
        string plainText = HttpUtility.HtmlDecode(rawText);
        return plainText;
    }

    private async Task GetApod() 
    {
        var httpClient = HttpClientFactory.CreateClient("Api");
        apod = await httpClient.GetFromJsonAsync<Apod>($"/apod/date/{SelectedDate.ToString("yyMMdd")}");
    }

    private async Task SaveApod()
    {
        var httpClient = HttpClientFactory.CreateClient("Api");
        await httpClient.PostAsJsonAsync("/apod/", apod);
    }
}
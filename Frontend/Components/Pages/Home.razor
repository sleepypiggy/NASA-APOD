@page "/"

@rendermode InteractiveServer

@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

@if (apod is null) {
    <p> Loading... </p>
} 
else 
{
    <div class="apod-container">
        <div class="picture-title-container">
            @* <button popovertarget="hd-image-@apod.Id" id="popover-button">
                <img src="@apod.Url" alt="Astronomy picture for @apod.Date" id="pod"/>
            </button>
            <img popover src="@apod.Hdurl" id="hd-image-@apod.Id" /> *@
            <img src="@apod.Url" alt="Astronomy picture for @apod.Date" id="pod"/>
            <h2 id="title"> @apod.Title </h2>
        </div>
        <div class="control-container"> 
            <p> Media Type: @apod.MediaType </p>
            <p> Version: @apod.ServiceVersion </p>
            <NavLink href="@apod.Hdurl" id="hd-image-link" target="_blank"> HD Image </NavLink> <br />
            <input type="Date" min ="1995-06-16" @bind="SelectedDate" id="date-selector"/>
            <button @onclick="GetApod" id="find-apod-button"> Find </button>
            <button @onclick="SaveApod" id="save-apod-button"> Save </button>
        </div>
        <div class="explanation-container"> 
            <p> @apod.Explanation </p>
        </div>
    </div>
}




@code {
    public DateOnly SelectedDate{ get; set; } = DateOnly.FromDateTime(DateTime.Today);
    private Apod? apod;

    protected override async Task OnInitializedAsync()
    {
        await GetApod();
    }

    public async Task GetApod() 
    {
        var httpClient = HttpClientFactory.CreateClient("Api");
        apod = await httpClient.GetFromJsonAsync<Apod>($"/apod/date/{SelectedDate}");
    }

    public async Task SaveApod()
    {
        var httpClient = HttpClientFactory.CreateClient("Api");
        await httpClient.PostAsJsonAsync("/apod/", apod);
    }
}